# Miko API Configuration
MIKO_API_KEY=your_miko_api_key_here
MIKO_BASE_URL=https://api-miko.yokoya.space
MIKO_SERVICE=qwen-max
MIKO_USERNAME=iris_user
MIKO_USERID=iris_local_1

# Capabilities (search is true by default so model searches when needed)
MIKO_SEARCH=true
MIKO_THINKING=false

# Prompt File
PROMPT_FILE=prompts.json

# Runtime Config
MAX_HISTORY_MESSAGES=20
REQUEST_TIMEOUT_SECONDS=60

# Optional n8n Webhook
N8N_WEBHOOK_URL=

# Vision & Grounding Settings
MIKO_VISION_SERVICE=qwen-max
IRIS_VISION_CACHE_DIR=.iris_cache
IRIS_VISION_COMPRESS_QUALITY=85
IRIS_VISION_MAX_DIMENSION=1920
IRIS_VISION_GRID_OVERLAY=false

# Desktop Actuator Settings
IRIS_ACTUATOR_ENABLED=true
IRIS_ACTUATOR_TYPING_DELAY=0.02
IRIS_ACTUATOR_MOUSE_DURATION=0.2

# Global Panic Killswitch
IRIS_KILLSWITCH_HOTKEY=<ctrl>+<shift>+k

# Voice Engine Settings
IRIS_VOICE_ENABLED=false
IRIS_VOICE_TTS_VOICE=en-US-AvaMultilingualNeural
IRIS_VOICE_TTS_RATE=+0%
IRIS_VOICE_STT_MODEL=base.en
IRIS_VOICE_STT_COMPUTE=int8
