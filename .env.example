# Miko API Configuration
MIKO_API_KEY=your_miko_api_key_here
MIKO_BASE_URL=https://api-miko.yokoya.space
MIKO_SERVICE=qwen-max
MIKO_USERNAME=iris_user
MIKO_USERID=iris_local_1

# Capabilities (search is true by default so model searches when needed)
MIKO_SEARCH=true
MIKO_THINKING=false

# Prompt File
PROMPT_FILE=prompts.json

# Runtime Config
MAX_HISTORY_MESSAGES=20
REQUEST_TIMEOUT_SECONDS=60

# Optional n8n Webhook
N8N_WEBHOOK_URL=
