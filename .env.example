# Miko API Configuration
MIKO_API_KEY=your_miko_api_key_here
MIKO_BASE_URL=https://api-miko.yokoya.space/v1
MIKO_MODEL=gemini-2.5-flash

# System Prompt
SYSTEM_PROMPT=You are Iris, a smart and responsive desktop AI assistant. Keep responses clear, concise, and helpful.

# Runtime Config
MAX_HISTORY_MESSAGES=20
TEMPERATURE=0.7
REQUEST_TIMEOUT_SECONDS=60

# Optional n8n Webhook
N8N_WEBHOOK_URL=
